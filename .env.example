# --- Database ---
# For local dev, SQLite is used automatically if DATABASE_URL is left as sqlite.
# For MySQL, use: mysql+pymysql://user:password@localhost:3306/fashion_db
DATABASE_URL=sqlite:///./fashion.db

# --- Auth ---
JWT_SECRET=change_this_dev_secret_before_any_real_deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# --- AI ---
# demo = deterministic heuristic classifier (no trained model needed, always available)
# model = load a real trained model from MODEL_PATH (not bundled by default)
AI_MODE=demo
MODEL_PATH=./ai_models/clothing_classifier.pt

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
