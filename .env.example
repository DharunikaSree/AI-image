# --- Database ---
# For SQLite (default in Docker / Railway):
DATABASE_URL=sqlite:///./fashion.db
# For MySQL / PostgreSQL if attached:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fashion_db

# --- Auth ---
# Set a strong, randomly generated JWT secret in Railway environment variables (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_strong_random_jwt_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Uploads & Dataset ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
# Comma-separated list of directories to search for catalog images
DATASET_IMAGES_DIR=/app/data/images,./data/images,../data/images

# --- AI ---
# demo = deterministic heuristic classifier
# model = load trained Vision Transformer from MODEL_PATH
AI_MODE=model
MODEL_PATH=./models/vit_fashion_classifier/vit_fashion_classifier.pt

# --- CORS ---
# In production, set your Vercel frontend URL:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://ai-image-pi-nine.vercel.app,https://your-frontend.vercel.app

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# --- Frontend (Set on Vercel deployment) ---
VITE_API_BASE_URL=https://your-railway-app.up.railway.app/api

