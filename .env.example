# --- Database ---
# For local dev, SQLite is used automatically if DATABASE_URL is left as sqlite.
# For MySQL, use: mysql+pymysql://user:password@localhost:3306/fashion_db
DATABASE_URL=sqlite:///./fashion.db

# --- Auth ---
JWT_SECRET=change_this_dev_secret_before_any_real_deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Uploads & Dataset ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
# Comma-separated list of directories to search for product images (high-res first, then fallback)
DATASET_IMAGES_DIR=./data/fashion-dataset/images,./data/images

# --- AI ---
# demo = deterministic heuristic classifier (no trained model needed, always available)
# model = load a real trained model from MODEL_PATH
AI_MODE=model
MODEL_PATH=./models/vit_fashion_classifier/vit_fashion_classifier.pt

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000,http://127.0.0.1:3000

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
